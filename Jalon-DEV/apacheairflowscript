from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.models import Variable
from datetime import datetime, timedelta
import os
import io
import zipfile
import sys
import subprocess
import importlib

def ensure_packages():
	pkgs = ["requests", "pandas", "duckdb"]
	for p in pkgs:
		try:
			importlib.import_module(p)
		except ImportError:
			subprocess.check_call([sys.executable, "-m", "pip", "install", "--no-cache-dir", p])
	globals()["requests"] = importlib.import_module("requests")
	globals()["pd"] = importlib.import_module("pandas")
	globals()["duckdb"] = importlib.import_module("duckdb")
	
def _paths():
	data_dir = Variable.get("DATA_DIR", default_var="/opt/airflow/include/data")
	db_path = Variable.get("DUCKDB_PATH", default_var="/opt/airflow/include/data/gtfs.duckdb")
	os.makedirs(data_dir, exist_ok=True)
	return data_dir, db_path

def download_gtfs(**context):
	ensure_packages()
	url = Variable.get("GTFS_FEED_URL", default_var="")
	if not url:
		raise ValueError("Set Airflow Variable GTFS_FEED_URL to a GTFS zip URL")
	data_dir, _ = _paths()
	zip_path = os.path.join(data_dir, "gtfs_latest.zip")
	r = requests.get(url, timeout=90)
	r.raise_for_status()
	with open(zip_path, "wb") as f:
		f.write(r.content)
	context["ti"].xcom_push(key="zip_path", value=zip_path)

def extract_gtfs(**context):
	zip_path = context["ti"].xcom_pull(key="zip_path", task_ids="download_gtfs")
	data_dir, _ = _paths()
	extract_dir = os.path.join(data_dir, "extracted")
	os.makedirs(extract_dir, exist_ok=True)
	for root, _, files in os.walk(extract_dir):
		for name in files:
			try:
				os.remove(os.path.join(root, name))
			except FileNotFoundError:
				pass
	wanted = {"stops.txt", "routes.txt"}
	with zipfile.ZipFile(zip_path, "r") as z:
		for name in z.namelist():
			base = os.path.basename(name)
			if base in wanted:
				z.extract(name, extract_dir)
	context["ti"].xcom_push(key="extract_dir", value=extract_dir)

def load_stops_duckdb(**context):
	ensure_packages()
	extract_dir = context["ti"].xcom_pull(key="extract_dir", task_ids="extract_gtfs")
	stops_file = None
	for root, _, files in os.walk(extract_dir):
		for f in files:
			if f == "stops.txt":
				stops_file = os.path.join(root, f)
				break
	if not stops_file:
		raise FileNotFoundError("stops.txt not found")
	df = pd.read_csv(stops_file)
	keep = ["stop_id", "stop_name", "stop_lat", "stop_lon"]
	cols = [c for c in keep if c in df.columns]
	if not cols:
		raise ValueError("stops.txt missing required columns")
	df = df[cols].drop_duplicates()
	_, db_path = _paths()
	con = duckdb.connect(db_path)
	con.execute("""
	CREATE TABLE IF NOT EXISTS stops (
	stop_id VARCHAR,
	stop_name VARCHAR,
	stop_lat DOUBLE,
	stop_lon DOUBLE
	)
	""")
	con.execute("DELETE FROM stops")
	con.register("stops_df", df)
	con.execute("INSERT INTO stops SELECT * FROM stops_df")
	con.close()

def load_routes_duckdb(**context):
	ensure_packages()
	extract_dir = context["ti"].xcom_pull(key="extract_dir", task_ids="extract_gtfs")
	routes_file = None
	for root, _, files in os.walk(extract_dir):
		for f in files:
			if f == "routes.txt":
				routes_file = os.path.join(root, f)
				break
	if not routes_file:
		raise FileNotFoundError("routes.txt not found")
	df = pd.read_csv(routes_file)
	keep = ["route_id", "agency_id", "route_short_name", "route_long_name", "route_type"]
	cols = [c for c in keep if c in df.columns]
	if not cols:
		raise ValueError("routes.txt missing required columns")
	df = df[cols].drop_duplicates()
	_, db_path = _paths()
	con = duckdb.connect(db_path)
	con.execute("""
	CREATE TABLE IF NOT EXISTS routes (
	route_id VARCHAR,
	agency_id VARCHAR,
	route_short_name VARCHAR,
	route_long_name VARCHAR,
	route_type INTEGER
	)
	""")
	con.execute("DELETE FROM routes")
	con.register("routes_df", df)
	con.execute("INSERT INTO routes SELECT * FROM routes_df")
	con.close()

def validate_duckdb():
	ensure_packages()
	_, db_path = _paths()
	con = duckdb.connect(db_path)
	stops_count = con.execute("SELECT COUNT(*) FROM stops").fetchone()[0]
	routes_count = con.execute("SELECT COUNT(*) FROM routes").fetchone()[0]
	con.close()
	if stops_count == 0 or routes_count == 0:
		raise ValueError(f"Validation failed. stops {stops_count} routes {routes_count}")
	print(f"Validation ok. stops {stops_count} routes {routes_count}")

DEFAULT_ARGS = dict(
owner="you",
retries=1,
retry_delay=timedelta(minutes=3)
)

with DAG(
dag_id="gtfs_duckdb_all_python",
description="GTFS to DuckDB with dependency install and validation",
start_date=datetime(2025, 11, 1),
schedule_interval="0 3 * * *",
catchup=False,
default_args=DEFAULT_ARGS,
max_active_runs=1,
tags=["gtfs", "duckdb"]
) as dag:    
	t_download = PythonOperator(
    task_id="download_gtfs",
    python_callable=download_gtfs
)

t_extract = PythonOperator(
    task_id="extract_gtfs",
    python_callable=extract_gtfs
)

t_load_stops = PythonOperator(
    task_id="load_stops_duckdb",
    python_callable=load_stops_duckdb
)

t_load_routes = PythonOperator(
    task_id="load_routes_duckdb",
    python_callable=load_routes_duckdb
)

t_validate = PythonOperator(
    task_id="validate_duckdb",
    python_callable=validate_duckdb
)

t_download >> t_extract >> [t_load_stops, t_load_routes] >> t_validate

